#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly project_root
readonly media_dir="$project_root/docs/media"
readonly output="$media_dir/sidecar-showcase.gif"
readonly canvas_width=1000
readonly canvas_height=563

fail() {
  printf 'build-marketing-gif: %s\n' "$*" >&2
  exit 1
}

for command_name in ffmpeg fc-match magick; do
  command -v "$command_name" >/dev/null 2>&1 || fail "required command not found: $command_name"
done

sans_font="$(fc-match -f '%{file}' 'Noto Sans:style=Bold')"
mono_font="$(fc-match -f '%{file}' 'JetBrainsMono Nerd Font:style=Bold')"
readonly sans_font mono_font
[[ -f $sans_font && -f $mono_font ]] || fail "required Noto Sans and JetBrains Mono fonts were not found"

for source_image in \
  desktop-sidecar-drop-attention.png \
  desktop-sidecar-pairing.png \
  phone-portal-dark-390.png \
  phone-portal-light-390.png \
  phone-morph-dark-390.png \
  phone-morph-light-390.png \
  phone-drop-dark-390.png \
  phone-drop-success-390.png; do
  [[ -f $media_dir/$source_image ]] || fail "missing current-product capture: $source_image"
done

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/sidecar-marketing.XXXXXX")
trap 'rm -rf -- "$work_dir"' EXIT

scene_svg() {
  local index="$1" accent="$2" eyebrow="$3" title_one="$4" title_two="$5"
  local body_one="$6" body_two="$7" chip_one="$8" chip_two="$9"
  local svg="$work_dir/scene-${index}.svg"
  local progress_x
  progress_x=$((index * 34))

  cat >"$svg" <<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="$canvas_width" height="$canvas_height" viewBox="0 0 $canvas_width $canvas_height">
  <defs>
    <linearGradient id="background" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0b0b10"/>
      <stop offset="0.58" stop-color="#13131b"/>
      <stop offset="1" stop-color="#21182e"/>
    </linearGradient>
    <radialGradient id="glow" cx="78%" cy="48%" r="58%">
      <stop offset="0" stop-color="$accent" stop-opacity="0.46"/>
      <stop offset="0.58" stop-color="$accent" stop-opacity="0.12"/>
      <stop offset="1" stop-color="$accent" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid" width="56" height="56" patternUnits="userSpaceOnUse">
      <path d="M56 0H0V56" fill="none" stroke="#ffffff" stroke-opacity="0.022" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="1000" height="563" fill="url(#background)"/>
  <rect width="1000" height="563" fill="url(#glow)"/>
  <rect width="1000" height="563" fill="url(#grid)"/>
  <path d="M618 0H1000V563H710Z" fill="#ffffff" fill-opacity="0.026"/>
  <path d="M660 0H1000V563H752Z" fill="none" stroke="$accent" stroke-opacity="0.24"/>

  <g transform="translate(54 44)">
    <rect width="34" height="34" fill="none" stroke="$accent" stroke-width="2"/>
    <rect x="10" y="6" width="14" height="21" fill="none" stroke="#f6f3fb" stroke-opacity="0.9"/>
    <circle cx="17" cy="23" r="1.3" fill="$accent"/>
    <text x="48" y="13" fill="#ffffff" font-family="JetBrainsMono Nerd Font" font-size="11" font-weight="700" letter-spacing="3">SIDECAR</text>
    <text x="48" y="31" fill="#a7a2b3" font-family="JetBrainsMono Nerd Font" font-size="9" font-weight="700" letter-spacing="1.6">FOR OMARCHY</text>
    <text x="358" y="13" fill="#b9b3c2" font-family="JetBrainsMono Nerd Font" font-size="9" font-weight="700" letter-spacing="1.3">VERSION 0.2.1</text>
  </g>

  <g transform="translate(54 158)">
    <text fill="$accent" font-family="JetBrainsMono Nerd Font" font-size="12" font-weight="700" letter-spacing="3">$eyebrow</text>
    <text y="64" fill="#faf8fc" font-family="Noto Sans" font-size="49" font-weight="800" letter-spacing="-1.7">
      <tspan x="0">$title_one</tspan>
      <tspan x="0" dy="54">$title_two</tspan>
    </text>
    <text y="190" fill="#bbb6c5" font-family="Noto Sans" font-size="17" font-weight="400">
      <tspan x="0">$body_one</tspan>
      <tspan x="0" dy="27">$body_two</tspan>
    </text>
    <g transform="translate(0 252)" font-family="JetBrainsMono Nerd Font" font-size="9" font-weight="700" letter-spacing="1.2">
      <rect width="190" height="36" fill="#ffffff" fill-opacity="0.045" stroke="#ffffff" stroke-opacity="0.12"/>
      <rect x="8" y="9" width="4" height="18" fill="$accent"/>
      <text x="23" y="23" fill="#e8e4ed">$chip_one</text>
      <rect x="202" width="190" height="36" fill="#ffffff" fill-opacity="0.045" stroke="#ffffff" stroke-opacity="0.12"/>
      <rect x="210" y="9" width="4" height="18" fill="$accent"/>
      <text x="225" y="23" fill="#e8e4ed">$chip_two</text>
    </g>
  </g>

  <g transform="translate(54 522)">
    <text fill="#8b8594" font-family="JetBrainsMono Nerd Font" font-size="9" font-weight="700" letter-spacing="1.5">PHONE ↔ DESKTOP</text>
    <g transform="translate(598 0)">
      <rect width="26" height="3" fill="#ffffff" fill-opacity="0.14"/>
      <rect x="34" width="26" height="3" fill="#ffffff" fill-opacity="0.14"/>
      <rect x="68" width="26" height="3" fill="#ffffff" fill-opacity="0.14"/>
      <rect x="102" width="26" height="3" fill="#ffffff" fill-opacity="0.14"/>
      <rect x="136" width="26" height="3" fill="#ffffff" fill-opacity="0.14"/>
      <rect x="170" width="26" height="3" fill="#ffffff" fill-opacity="0.14"/>
      <rect x="$progress_x" y="-1" width="26" height="5" fill="$accent"/>
    </g>
    <text x="890" fill="#8b8594" font-family="JetBrainsMono Nerd Font" font-size="9" font-weight="700">0$((index + 1)) / 06</text>
  </g>
</svg>
SVG
  magick "$svg" "$work_dir/scene-${index}-base.png"
}

phone_panel() {
  local input="$1" crop="$2" width="$3" x="$4" y="$5" accent="$6" target_path="$7"
  local panel="$work_dir/panel-$RANDOM.png"
  magick "$media_dir/$input" -crop "$crop" +repage -resize "${width}x" \
    -bordercolor '#0b0c11' -border 7 \
    -bordercolor "$accent" -border 1 "$panel"
  magick "$target_path" "$panel" -geometry "+${x}+${y}" -composite "$target_path"
}

scene_svg 0 '#9b6cff' 'PRIVATE PHONE COMPANION' 'OMARCHY.' 'ON YOUR PHONE.' \
  'Switch apps. Change themes. Send files.' 'Private through your existing Tailscale.' 'FAST TO USE' 'PRIVATE BY DESIGN'
cp "$work_dir/scene-0-base.png" "$work_dir/scene-0.png"
phone_panel phone-portal-dark-390.png '248x530+0+0' 285 690 8 '#9b6cff' "$work_dir/scene-0.png"

scene_svg 1 '#f6c453' 'PAIR IN SECONDS' 'SCAN. MATCH.' 'APPROVE.' \
  'Scan with your normal phone camera.' 'Match three words. Approve locally.' 'NORMAL CAMERA' 'LOCAL APPROVAL'
cp "$work_dir/scene-1-base.png" "$work_dir/scene-1.png"
magick "$media_dir/desktop-sidecar-pairing.png" -crop '390x560+885+28' +repage -resize '350x' \
  -bordercolor '#0b0c11' -border 7 -bordercolor '#f6c453' -border 1 "$work_dir/pairing-panel.png"
magick "$work_dir/scene-1.png" "$work_dir/pairing-panel.png" -geometry '+620+28' -composite "$work_dir/scene-1.png"

scene_svg 2 '#a56cff' 'PORTAL' 'FOCUS. SWITCH.' 'MOVE.' \
  'Tap an app. Swipe workspaces.' 'Hold to move a window—never by accident.' 'EXACT TARGETS' 'NO SCREEN STREAM'
cp "$work_dir/scene-2-base.png" "$work_dir/scene-2.png"
phone_panel phone-portal-dark-390.png '248x530+0+0' 210 580 72 '#a56cff' "$work_dir/scene-2.png"
phone_panel phone-portal-light-390.png '250x531+0+0' 210 780 35 '#a56cff' "$work_dir/scene-2.png"

scene_svg 3 '#57d8c6' 'MORPH' 'THEMES, WITHOUT' 'THE FRICTION.' \
  'Preview themes already installed.' 'Tap to apply. Undo in one touch.' 'REAL WALLPAPERS' 'DARK + LIGHT'
cp "$work_dir/scene-3-base.png" "$work_dir/scene-3.png"
phone_panel phone-morph-dark-390.png '254x530+0+0' 225 620 45 '#57d8c6' "$work_dir/scene-3.png"
phone_panel phone-morph-light-390.png '250x530+0+0' 225 760 24 '#57d8c6' "$work_dir/scene-3.png"

scene_svg 4 '#ff6f91' 'DROP' 'CHOOSE. CONFIRM.' 'DELIVERED.' \
  'Send screenshots or small documents' 'to one fixed private Sidecar Inbox.' '1–5 FILES' '25 MB EACH'
cp "$work_dir/scene-4-base.png" "$work_dir/scene-4.png"
phone_panel phone-drop-dark-390.png '390x844+0+0' 230 630 20 '#ff6f91' "$work_dir/scene-4.png"
phone_panel phone-drop-success-390.png '390x844+0+0' 230 760 34 '#ff6f91' "$work_dir/scene-4.png"

scene_svg 5 '#7aa2ff' 'PRIVATE BY DESIGN' 'USEFUL CONTROL.' 'NO REMOTE SHELL.' \
  'Tailscale transport. Per-phone scopes.' 'Local approval. Lock-aware controls.' 'NO CLOUD RELAY' 'NO REMOTE SHELL'
cp "$work_dir/scene-5-base.png" "$work_dir/scene-5.png"
phone_panel phone-portal-dark-390.png '375x600+0+0' 205 775 28 '#7aa2ff' "$work_dir/scene-5.png"
magick "$media_dir/desktop-sidecar-drop-attention.png" -crop '390x350+885+28' +repage -resize '360x' \
  -bordercolor '#0b0c11' -border 7 -bordercolor '#7aa2ff' -border 1 "$work_dir/desktop-panel.png"
magick "$work_dir/scene-5.png" "$work_dir/desktop-panel.png" -geometry '+600+294' -composite "$work_dir/scene-5.png"

ffmpeg -hide_banner -loglevel error -y \
  -loop 1 -t 2.65 -i "$work_dir/scene-0.png" \
  -loop 1 -t 2.65 -i "$work_dir/scene-1.png" \
  -loop 1 -t 2.65 -i "$work_dir/scene-2.png" \
  -loop 1 -t 2.65 -i "$work_dir/scene-3.png" \
  -loop 1 -t 2.65 -i "$work_dir/scene-4.png" \
  -loop 1 -t 2.65 -i "$work_dir/scene-5.png" \
  -loop 1 -t 2.65 -i "$work_dir/scene-0.png" \
  -filter_complex \
    "[0:v][1:v]xfade=transition=fade:duration=0.35:offset=2.30[v1]; \
     [v1][2:v]xfade=transition=fade:duration=0.35:offset=4.60[v2]; \
     [v2][3:v]xfade=transition=fade:duration=0.35:offset=6.90[v3]; \
     [v3][4:v]xfade=transition=fade:duration=0.35:offset=9.20[v4]; \
     [v4][5:v]xfade=transition=fade:duration=0.35:offset=11.50[v5]; \
     [v5][6:v]xfade=transition=fade:duration=0.35:offset=13.80, \
     fps=10,split[frames][palettebase]; \
     [palettebase]palettegen=max_colors=112:stats_mode=diff[palette]; \
     [frames][palette]paletteuse=dither=bayer:bayer_scale=3:diff_mode=rectangle" \
  -t 14.15 -loop 0 "$output"

magick "$output" -layers Optimize "$work_dir/optimized.gif"
mv -- "$work_dir/optimized.gif" "$output"

frame_count=$(identify "$output" | wc -l)
dimensions=$(identify -format '%wx%h' "${output}[0]")
printf 'Built %s (%s, %s frames, %s bytes).\n' "$output" \
  "$dimensions" "$frame_count" "$(stat -c '%s' "$output")"
